#!/usr/bin/env bash
set -euo pipefail

remote_name="${1:-origin}"
remote_url="${2:-unknown}"
blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
  # Skip empty lines (defensive)
  [ -z "${local_ref:-}" ] && continue

  if [ "$remote_ref" = "refs/heads/main" ] || [ "$remote_ref" = "refs/heads/master" ]; then
    echo "BLOCKED: push to protected branch '$remote_ref' is disabled in this repo." >&2
    echo "Remote: $remote_name ($remote_url)" >&2
    echo "Allowed: push to non-main branches only (e.g., codemini-isolated)." >&2
    blocked=1
  fi

done

if [ "$blocked" -ne 0 ]; then
  exit 1
fi

exit 0
