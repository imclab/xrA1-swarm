{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xra1.local/evaluation/xrai_timeline.schema.json",
  "title": "XRAI Timeline Interchange",
  "type": "object",
  "required": [
    "spec_version",
    "created_at_utc",
    "run",
    "time",
    "entities",
    "events"
  ],
  "properties": {
    "spec_version": {
      "type": "string",
      "const": "xrai-timeline-0.1"
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "run": {
      "type": "object",
      "required": [
        "run_id"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "time": {
      "type": "object",
      "required": [
        "unit",
        "origin"
      ],
      "properties": {
        "unit": {
          "type": "string",
          "const": "ms"
        },
        "origin": {
          "type": "string",
          "const": "run_start"
        }
      },
      "additionalProperties": false
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "attrs": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "t0_ms",
          "t1_ms",
          "entity_id",
          "scenario_id",
          "what",
          "where",
          "why",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "t0_ms": {
            "type": "integer",
            "minimum": 0
          },
          "t1_ms": {
            "type": "integer",
            "minimum": 0
          },
          "entity_id": {
            "type": "string"
          },
          "scenario_id": {
            "type": "string"
          },
          "phase": {
            "type": [
              "string",
              "null"
            ]
          },
          "what": {
            "type": "string"
          },
          "where": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "metrics": {
            "type": "object",
            "properties": {
              "duration_ms": {
                "type": "integer",
                "minimum": 0
              },
              "tokens_total": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
